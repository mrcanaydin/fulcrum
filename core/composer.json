{
    "name": "fulcrum/core",
    "description": "Fulcrum — a headless, GraphQL-first PHP 8.2+ framework engine",
    "type": "library",
    "license": "MIT",
    "keywords": ["framework", "graphql", "headless", "api", "php", "cache", "storage", "flysystem"],
    "require": {
        "php": "^8.2",
        "league/flysystem": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-local": "^3.0",
        "mongodb/mongodb": "^2.3",
        "predis/predis": "^2.2",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "symfony/filesystem": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "webonyx/graphql-php": "^15.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "pestphp/pest": "^3.7",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Fulcrum\\": "src/Fulcrum/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fulcrum\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/fulcrum"
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "fulcrum-providers": [
            "Fulcrum\\Console\\ConsoleServiceProvider",
            "Fulcrum\\Cache\\CacheServiceProvider",
            "Fulcrum\\Logging\\LoggingServiceProvider",
            "Fulcrum\\Events\\EventServiceProvider",
            "Fulcrum\\Database\\DatabaseServiceProvider",
            "Fulcrum\\Auth\\AuthServiceProvider",
            "Fulcrum\\Queue\\QueueServiceProvider",
            "Fulcrum\\Mail\\MailServiceProvider",
            "Fulcrum\\Notifications\\NotificationServiceProvider",
            "Fulcrum\\Observability\\ObservabilityServiceProvider",
            "Fulcrum\\GraphQL\\GraphQLServiceProvider",
            "Fulcrum\\Storage\\StorageServiceProvider",
            "Fulcrum\\Validation\\ValidationServiceProvider"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
