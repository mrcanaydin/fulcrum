APP_NAME=Fulcrum
APP_ENV=local
APP_DEBUG=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,tr

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fulcrum
DB_USERNAME=fulcrum
DB_PASSWORD=secret

STORAGE_DISK=local
STORAGE_LOCAL_ROOT=/var/www/html/storage/app

CACHE_STORE=file
CACHE_FILE_PATH=/var/www/html/storage/cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CACHE_PREFIX=fulcrum:

LOG_CHANNEL=file
LOG_FILE_PATH=/var/www/html/storage/logs/fulcrum.log

MAIL_MAILER=log
MAIL_LOG_PATH=/var/www/html/storage/logs/mail.log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com

NOTIFICATION_CHANNEL=log
NOTIFICATIONS_QUEUE=true
NOTIFICATION_LOG_PATH=/var/www/html/storage/logs/notifications.log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_TIMEOUT=10

QUEUE_CONNECTION=sync
QUEUE_JOBS_TABLE=jobs
QUEUE_NAME=default
QUEUE_FAILED_JOBS_TABLE=failed_jobs
QUEUE_RETRY_AFTER=90
QUEUE_TRIES=3
QUEUE_TIMEOUT=60
QUEUE_BACKOFF=5
QUEUE_MAX_BACKOFF=300

GRAPHQL_SLOW_RESOLVER_MS=100
GRAPHQL_PERSISTED_QUERIES=true
GRAPHQL_ALLOW_LIST=false
GRAPHQL_ALLOW_LIST_PATH=/var/www/html/graphql-allow-list.json
GRAPHQL_PERSISTED_QUERY_TTL=86400
GRAPHQL_SCHEMA_CACHE=true
GRAPHQL_SCHEMA_CACHE_KEY=graphql:schema:snapshot
GRAPHQL_SCHEMA_CACHE_TTL=86400
SUBSCRIPTION_EVENTS_TABLE=subscription_events
SUBSCRIPTION_RETENTION_SECONDS=86400

HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_CACHE=true
HEALTH_CHECK_QUEUE=true
HEALTH_CHECK_STORAGE=true

USER_EMAIL_VERIFICATION_ENABLED=false
USER_EMAIL_VERIFICATION_EXPIRES_MINUTES=60
USER_EMAIL_VERIFICATION_RATE_LIMIT_MAX_ATTEMPTS=5
USER_EMAIL_VERIFICATION_RATE_LIMIT_DECAY_SECONDS=3600
USER_WELCOME_EMAIL_ENABLED=false
USER_WELCOME_EMAIL_MAILER=
USER_WELCOME_PUSH_ENABLED=false
USER_WELCOME_PUSH_CHANNEL=log

AUTH_TOKEN_ABILITIES=users:read,uploads:create
AUTH_TOKEN_TTL_SECONDS=2592000
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_DECAY_SECONDS=900

API_MAX_BODY_BYTES=1048576
TRUSTED_PROXIES=
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
